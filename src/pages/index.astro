---
import { Image } from 'astro:assets';
import profilePic from '../assets/profile.jpg';
import { getSite } from '../utils/consts';
import { ICONS, socials, newItems, currentProjects, friendProjects, videos, resources, llmBakeOffs } from '../data/home';

const site = await getSite();
const SITE_URL = 'https://www.richkuo.com';
const pageTitle = 'Rich Kuo — Product Engineer';
const metaDescription =
	'Product engineer building creative and technical products like SceneCut AI, go-trader, and VibeCode Support.';
const ogImage = `${SITE_URL}/og-home.png`;
const profileURL = new URL(profilePic.src, SITE_URL).toString();
const sameAs = socials.filter((s) => s.href.startsWith('http')).map((s) => s.href);

const personJsonLd = {
	'@type': 'Person',
	'@id': `${SITE_URL}/#person`,
	name: 'Rich Kuo',
	url: `${SITE_URL}/`,
	image: profileURL,
	jobTitle: 'Product Engineer',
	description: site.author?.bio ?? site.description,
	knowsAbout: site.author?.knowsAbout ?? [],
	sameAs,
};

const websiteJsonLd = {
	'@type': 'WebSite',
	'@id': `${SITE_URL}/#website`,
	name: 'Rich Kuo',
	url: `${SITE_URL}/`,
	description: site.description,
	inLanguage: 'en-US',
	publisher: { '@id': `${SITE_URL}/#person` },
};

const profilePageJsonLd = {
	'@type': 'ProfilePage',
	'@id': `${SITE_URL}/#profilepage`,
	url: `${SITE_URL}/`,
	name: 'Rich Kuo — Product Engineer',
	isPartOf: { '@id': `${SITE_URL}/#website` },
	about: { '@id': `${SITE_URL}/#person` },
	mainEntity: { '@id': `${SITE_URL}/#person` },
	inLanguage: 'en-US',
};

const llmBakeOffsItemList = {
	'@type': 'ItemList',
	'@id': `${SITE_URL}/#llm-bake-offs`,
	name: 'LLM Bake-Offs — AI coding bake-offs',
	description:
		'Head-to-head bake-offs scoring frontier AI models (GPT, Claude Opus, GLM, Fable, Composer) on identical real-world coding tasks — cost, speed, review rounds, and code quality.',
	itemListOrder: 'https://schema.org/ItemListOrderAscending',
	numberOfItems: llmBakeOffs.length,
	itemListElement: llmBakeOffs.map((b, i) => ({
		'@type': 'ListItem',
		position: i + 1,
		name: b.title,
		url: `${SITE_URL}${(b.href ?? '').replace(/index\.html$/, '')}`,
	})),
};

const graphJsonLd = {
	'@context': 'https://schema.org',
	'@graph': [personJsonLd, websiteJsonLd, profilePageJsonLd, llmBakeOffsItemList],
};
const WORK_MAIL = 'mailto:rich.kuo.ai@gmail.com?subject=Work%20with%20me';

const building = [
	...currentProjects.map((p) => ({ ...p, tag: 'Current project' })),
	...friendProjects.map((p) => ({ ...p, tag: 'Friend project' })),
];
const newLinks = new Set(newItems.map((n) => n.link));
const pad = (n: number) => String(n).padStart(2, '0');
const isExternal = (href: string) => /^(https?:|mailto:)/.test(href);
const prettyUrl = (u?: string) => (u ?? '').replace(/^https?:\/\/(www\.)?/, '').replace(/\/$/, '');
const CYCLE = ['accent', 'accent2', 'accent3'];
const tone = (i: number) => {
	const k = CYCLE[i % CYCLE.length];
	return `--c: var(--${k}); --ct: var(--${k}-text); --c-ink: var(--${k}-ink)`;
};
const zoomPhrases = [
	["It's time for", 'your next adventure'],
	['I have no idea what', "I'm going to do tomorrow"],
	['How', 'exciting'],
];
---
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>{pageTitle}</title>
<meta name="description" content={metaDescription} />
<meta name="author" content="Rich Kuo" />
<link rel="canonical" href="https://www.richkuo.com/" />
<meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
<link rel="sitemap" href="/sitemap-index.xml" />
<link rel="alternate" type="application/rss+xml" title="Rich Kuo" href="https://www.richkuo.com/rss.xml" />
<meta name="theme-color" content="#050505" id="themeColor" />
<script is:inline>
  (function () {
    var pref = null;
    try { pref = localStorage.getItem('theme-pref'); } catch (e) {}
    var dark = pref === 'dark' || pref === 'light' ? pref === 'dark' : matchMedia('(prefers-color-scheme: dark)').matches;
    document.documentElement.setAttribute('data-theme', dark ? 'dark' : 'light');
    document.documentElement.setAttribute('data-theme-pref', pref === 'dark' || pref === 'light' ? pref : 'system');
  })();
</script>
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<meta property="og:type" content="website" />
<meta property="og:site_name" content="Rich Kuo" />
<meta property="og:title" content={pageTitle} />
<meta property="og:description" content={metaDescription} />
<meta property="og:url" content="https://www.richkuo.com/" />
<meta property="og:image" content={ogImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content="Rich Kuo — Product Engineer" />
<meta property="og:locale" content="en_US" />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:site" content="@richkuo7" />
<meta name="twitter:creator" content="@richkuo7" />
<meta name="twitter:title" content={pageTitle} />
<meta name="twitter:description" content={metaDescription} />
<meta name="twitter:image" content={ogImage} />
<meta name="twitter:image:alt" content="Rich Kuo — Product Engineer" />
<script type="application/ld+json" set:html={JSON.stringify(graphJsonLd)} />
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Anton&family=Inter:wght@400;500;700&family=Unbounded:wght@600;800&display=swap" rel="stylesheet" />

<style is:global>
  :root {
    --black: #050505;
    --white: #efefef;
    --grey: #9a9a9a;
    --amber: #fbbf24;
    --amber-ink: #1a1203;
    --forest: #16a34a;
    --forest-ink: #ffffff;
    --royal: #4169e1;
    --royal-ink: #ffffff;
    --accent: var(--amber);
    --accent-ink: var(--amber-ink);
    --accent-text: var(--amber);
    --accent2: var(--forest);
    --accent2-ink: var(--forest-ink);
    --accent2-text: var(--forest);
    --accent3: var(--royal);
    --accent3-ink: var(--royal-ink);
    --accent3-text: var(--royal);
    --c: var(--accent);
    --ct: var(--accent-text);
    --c-ink: var(--accent-ink);
    --bg: #050505;
    --fg: #efefef;
    --muted: #9a9a9a;
    --body: color-mix(in oklab, #efefef 88%, transparent);
    --media-bg: #151515;
    --alt-bg: #efefef;
    --alt-fg: #050505;
    --alt-muted: #a3a3a3;
    --alt-body: #4a4a4a;
    --alt-line: #c8c8c8;
    --alt-border: #1a1a1a;
    --thumb-bg: #dddddd;
    --font-display: "Anton", "Impact", sans-serif;
    --font-wide: "Unbounded", "Arial Black", sans-serif;
    --font-body: "Inter", ui-sans-serif, system-ui, sans-serif;
    --gutter: clamp(16px, 4vw, 64px);
    --ease-out-expo: cubic-bezier(.19, 1, .22, 1);
  }
  :root[data-theme="light"] {
    --bg: #efefef;
    --fg: #0a0a0a;
    --muted: #5f5f5f;
    --body: #2a2a2a;
    --media-bg: #dcdcdc;
    --alt-bg: #050505;
    --alt-fg: #efefef;
    --alt-muted: #7a7a7a;
    --alt-body: #b8b8b8;
    --alt-line: #2c2c2c;
    --alt-border: #3a3a3a;
    --thumb-bg: #1a1a1a;
    --accent: var(--forest);
    --accent-ink: var(--forest-ink);
    --accent-text: var(--forest);
    --accent2: var(--amber);
    --accent2-ink: var(--amber-ink);
    --accent2-text: var(--amber);
  }
  @media (prefers-color-scheme: light) {
    :root:not([data-theme]) {
      --bg: #efefef;
      --fg: #0a0a0a;
      --muted: #5f5f5f;
      --body: #2a2a2a;
      --media-bg: #dcdcdc;
      --alt-bg: #050505;
      --alt-fg: #efefef;
      --alt-muted: #7a7a7a;
      --alt-body: #b8b8b8;
      --alt-line: #2c2c2c;
      --alt-border: #3a3a3a;
      --thumb-bg: #1a1a1a;
      --accent: var(--forest);
      --accent-ink: var(--forest-ink);
      --accent-text: var(--forest);
      --accent2: var(--amber);
      --accent2-ink: var(--amber-ink);
      --accent2-text: var(--amber);
    }
  }
  * { box-sizing: border-box; }
  html { overflow-x: clip; background: var(--bg); color-scheme: dark; }
  :root[data-theme="light"] { color-scheme: light; }
  html:not(.live) { scroll-snap-type: y proximity; }
  html.lenis, html.lenis body { height: auto; }
  .lenis.lenis-smooth { scroll-behavior: auto !important; }
  body {
    margin: 0; background: var(--bg); color: var(--fg);
    transition: background-color .4s ease, color .4s ease;
    font-family: var(--font-body); line-height: 1.5;
    -webkit-font-smoothing: antialiased; overflow-x: clip;
  }
  a { color: inherit; text-decoration: none; }
  img { display: block; max-width: 100%; }
  h1, h2, h3, p { margin: 0; }
  :focus-visible { outline: 2px solid var(--accent); outline-offset: 4px; }

  #progress {
    position: fixed; inset: 0 0 auto 0; height: 4px; z-index: 60;
    background: var(--accent); transform: scaleX(0); transform-origin: 0 50%;
  }
  #stars { position: fixed; inset: 0; width: 100%; height: 100%; z-index: 0; pointer-events: none; }
  .glow {
    position: fixed; inset: auto 0 0 0; height: 70vh; z-index: 0; pointer-events: none;
    background:
      radial-gradient(60% 70% at 8% 115%, color-mix(in oklab, var(--accent2) 24%, transparent), transparent 70%),
      radial-gradient(60% 70% at 92% 115%, color-mix(in oklab, var(--accent3) 26%, transparent), transparent 70%),
      radial-gradient(120% 90% at 50% 120%, color-mix(in oklab, var(--accent) 22%, transparent), transparent 70%);
  }
  #cursor {
    position: fixed; top: 0; left: 0; z-index: 70; pointer-events: none;
    width: 40px; height: 40px; margin: -20px 0 0 -20px; border-radius: 50%;
    border: 1.5px solid var(--accent); opacity: 0;
    transition: width .35s var(--ease-out-expo), height .35s var(--ease-out-expo), margin .35s var(--ease-out-expo), background-color .35s;
  }
  #cursor.is-hover { width: 72px; height: 72px; margin: -36px 0 0 -36px; background: color-mix(in oklab, var(--accent) 18%, transparent); }

  /* ---- header ---- */
  .nav {
    position: fixed; inset: 0 0 auto 0; z-index: 50;
    display: grid; grid-template-columns: 1fr auto 1fr; align-items: center;
    padding: 18px var(--gutter); color: var(--fg);
    font-family: var(--font-body); font-weight: 700; font-size: 14px;
    letter-spacing: .02em; text-transform: uppercase;
    transition: color .4s ease;
  }
  .nav::before {
    content: ""; position: absolute; inset: 0 0 -40px 0; z-index: -1; pointer-events: none;
    background: linear-gradient(var(--bg) 30%, transparent); transition: opacity .4s ease;
  }
  .nav.on-alt { color: var(--alt-fg); }
  .nav.on-alt::before { background: linear-gradient(var(--alt-bg) 30%, transparent); }
  .nav-group { display: flex; gap: clamp(14px, 2.4vw, 40px); }
  .nav-group.right { justify-content: flex-end; align-items: center; }
  .theme-switch {
    display: inline-flex; gap: 2px; padding: 3px; border-radius: 999px;
    border: 1px solid color-mix(in oklab, currentColor 28%, transparent);
  }
  .theme-switch button {
    display: grid; place-items: center; width: 28px; height: 28px; padding: 0;
    border: 0; border-radius: 999px; background: transparent; color: inherit; cursor: pointer;
    opacity: .55; transition: opacity .2s ease, background-color .2s ease, color .2s ease;
  }
  .theme-switch button:hover { opacity: 1; }
  .theme-switch button[aria-pressed="true"] { opacity: 1; background: var(--accent); color: var(--accent-ink); }
  .theme-switch svg { width: 15px; height: 15px; }
  .nav-group a { position: relative; }
  .nav-group a::after {
    content: ""; position: absolute; left: 0; right: 0; bottom: -4px; height: 2px;
    background: currentColor; transform: scaleX(0); transform-origin: 100% 50%;
    transition: transform .5s var(--ease-out-expo);
  }
  .nav-group a:hover::after { transform: scaleX(1); transform-origin: 0 50%; }
  .badge {
    display: grid; place-items: center; height: 44px; padding: 0 16px; border-radius: 8px; white-space: nowrap;
    background: var(--accent); color: var(--accent-ink);
    font: inherit; letter-spacing: inherit; text-transform: inherit;
    transition: transform .5s var(--ease-out-expo);
  }
  .badge:hover { transform: rotate(-8deg) scale(1.06); }
  @media (max-width: 760px) {
    .nav-group.left a:not(:first-child), .nav-group.right a:not(:last-child) { display: none; }
  }

  main, footer { position: relative; z-index: 1; }
  .sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }

  /* ---- hero ---- */
  .hero {
    min-height: 100svh; display: flex; flex-direction: column;
    padding: 110px var(--gutter) clamp(28px, 9vh, 96px);
  }
  .hero-name {
    font-family: var(--font-display); font-weight: 400; color: var(--accent-text);
    line-height: .86; text-transform: uppercase; white-space: nowrap;
    font-size: 22.5vw; letter-spacing: -.01em;
    display: flex; justify-content: center; gap: .12em;
  }
  .hero-name .word { display: inline-flex; }
  .hero-name .cl { display: inline-block; overflow: hidden; padding-top: .04em; will-change: transform; }
  .hero-name .ch { display: inline-block; will-change: transform; }
  .hero-role {
    margin-top: clamp(14px, 2vw, 28px); align-self: stretch; white-space: nowrap;
    font-family: var(--font-wide); font-weight: 800; text-transform: uppercase;
    font-size: 7.4vw; line-height: 1; letter-spacing: -.01em;
  }
  .hero-role .ch { display: inline-block; }
  .hero-socials { display: flex; flex-wrap: wrap; justify-content: center; gap: 12px; margin-top: clamp(20px, 3vw, 40px); }
  .hero-socials a {
    display: grid; place-items: center; width: 48px; height: 48px; border-radius: 50%;
    border: 1px solid color-mix(in oklab, var(--fg) 22%, transparent); color: var(--fg);
    transition: background-color .3s ease, color .3s ease, border-color .3s ease, transform .5s var(--ease-out-expo);
  }
  .hero-socials a:hover { background: var(--accent); border-color: var(--accent); color: var(--accent-ink); transform: translateY(-3px); }
  .hero-socials svg { width: 20px; height: 20px; }
  @media (max-width: 700px) {
    .hero-socials { gap: 6px; }
    .hero-socials a { width: 36px; height: 36px; }
    .hero-socials svg { width: 16px; height: 16px; }
  }
  .hero-foot {
    margin-top: auto; padding-top: 48px;
    display: flex; justify-content: center; align-items: center; gap: 24px clamp(32px, 4vw, 64px);
  }
  .scroll-cue {
    position: relative; padding-left: 22px; white-space: nowrap; flex-shrink: 0;
    font-family: var(--font-display); text-transform: uppercase;
    font-size: clamp(26px, 2.6vw, 40px); line-height: .95;
  }
  .scroll-cue::before {
    content: ""; position: absolute; left: 0; top: 0; bottom: 0; width: 2px;
    background: var(--accent); transform-origin: 50% 0; animation: cue 2.2s var(--ease-out-expo) infinite;
  }
  @keyframes cue { 0% { transform: scaleY(0); } 50% { transform: scaleY(1); transform-origin: 50% 0; } 51% { transform-origin: 50% 100%; } 100% { transform: scaleY(0); transform-origin: 50% 100%; } }
  .hero-me { display: flex; align-items: center; gap: 18px; }
  .avatar {
    flex-shrink: 0; width: clamp(64px, 6vw, 92px); height: auto; aspect-ratio: 1; border-radius: 50%;
    object-fit: cover; box-shadow: 0 0 0 3px var(--bg), 0 0 0 5px var(--accent);
  }
  .hero-tag { max-width: 34ch; font-weight: 700; text-transform: uppercase; font-size: 14px; line-height: 1.35; }
  .hero-tag em { font-style: normal; color: var(--accent-text); }
  .pills { display: flex; gap: 16px; justify-content: center; }
  .pill {
    position: relative; display: flex; align-items: center; overflow: hidden;
    min-width: min(300px, 100%); height: 60px; padding-right: 28px;
    border-radius: 14px; background: var(--accent); color: var(--accent-ink);
    font-weight: 700; text-transform: uppercase; font-size: 15px;
  }
  .pill .ico {
    display: grid; place-items: center; width: 56px; height: 56px; margin: 2px 22px 2px 2px;
    border-radius: 12px; background: var(--black); color: var(--accent);
    transition: width .6s var(--ease-out-expo);
  }
  .pill .ico svg { width: 26px; height: 26px; }
  .pill span:last-child { flex: 1; text-align: center; position: relative; z-index: 1; }
  .pill:hover .ico { width: calc(100% - 4px); }
  .pill:hover span:last-child { color: var(--accent); }
  .pill span:last-child { transition: color .3s ease .1s; }
  @media (max-width: 900px) {
    .hero-foot { flex-direction: column; align-items: stretch; }
    .scroll-cue { align-self: center; }
    .hero-me { justify-content: center; }
    .pills { justify-content: stretch; }
    .pill { flex: 1; }
  }
  @media (max-width: 700px) {
    .hero-name { flex-direction: column; align-items: center; white-space: normal; font-size: 40vw; }
  }

  /* ---- section heads ---- */
  .display {
    font-family: var(--font-display); font-weight: 400; text-transform: uppercase;
    line-height: .9; font-size: clamp(64px, 11vw, 190px);
  }
  .wide {
    font-family: var(--font-wide); font-weight: 800; text-transform: uppercase;
    line-height: 1.02; letter-spacing: -.01em;
  }

  /* ---- building: sticky title + fading items ---- */
  .building { padding: 18vh var(--gutter) 10vh; display: grid; grid-template-columns: 1fr 1fr; gap: 6vw; }
  .building-head { position: sticky; top: 0; height: 100vh; display: flex; flex-direction: column; justify-content: center; }
  .build-item { scroll-snap-align: center; min-height: 100vh; display: flex; flex-direction: column; justify-content: center; gap: 22px; max-width: 560px; }
  .live .building { height: 100vh; padding-top: 0; padding-bottom: 0; }
  .live .building-head { position: relative; }
  .live .building-wrap {
    height: 100vh; overflow: hidden;
    -webkit-mask-image: linear-gradient(transparent, #000 16%, #000 84%, transparent);
    mask-image: linear-gradient(transparent, #000 16%, #000 84%, transparent);
  }
  .live .building-list { display: flex; flex-direction: column; gap: 16vh; padding: 34vh 0; will-change: transform; }
  .live .build-item { min-height: 0; }
  .build-item .tag { font-weight: 700; font-size: 12px; letter-spacing: .2em; text-transform: uppercase; color: var(--muted); }
  .build-item h3 { color: var(--ct); font-size: clamp(30px, 3.6vw, 56px); }
  .build-item p { font-size: clamp(17px, 1.35vw, 22px); line-height: 1.5; color: var(--body); }
  .build-item .promo { align-self: flex-start; padding: 6px 12px; border-radius: 999px; border: 1px solid var(--accent-text); color: var(--accent-text); font-size: 13px; font-weight: 700; }
  .link-arrow {
    align-self: flex-start; display: inline-flex; gap: 10px; align-items: center;
    font-weight: 700; text-transform: uppercase; font-size: 14px; letter-spacing: .04em;
    border-bottom: 2px solid var(--c); padding-bottom: 4px;
  }
  .link-arrow svg { width: 16px; height: 16px; transition: transform .4s var(--ease-out-expo); }
  .link-arrow:hover svg { transform: translate(4px, -4px); }
  @media (max-width: 900px) {
    .building { grid-template-columns: 1fr; }
    .building-head { position: relative; height: auto; padding: 0 0 4vh; }
    .build-item { min-height: 70vh; }
    .live .building { height: 100svh; grid-template-rows: auto minmax(0, 1fr); gap: 0; padding-top: 88px; }
    .live .building-head { height: auto; padding: 0 0 2vh; }
    .live .building-head .display { font-size: clamp(44px, 13vw, 80px); }
    .live .building-wrap { height: 100%; }
    .live .building-list { padding: 16vh 0; gap: 12vh; }
  }

  /* ---- bake-offs: pinned horizontal track ---- */
  .show-intro { padding: 16vh var(--gutter) 8vh; display: grid; grid-template-columns: 1.2fr 1fr; gap: 6vw; align-items: end; }
  .show-intro p { font-size: clamp(17px, 1.35vw, 22px); max-width: 46ch; }
  .show-pin { position: relative; height: 100vh; display: flex; align-items: center; overflow: hidden; }
  .show-track {
    display: flex; gap: clamp(20px, 2.5vw, 48px); padding: 0 var(--gutter);
    overflow-x: auto; scroll-snap-type: x mandatory; width: 100%;
  }
  .live .show-track { overflow: visible; scroll-snap-type: none; width: max-content; }
  .show-card { flex: 0 0 clamp(280px, 38vw, 720px); scroll-snap-align: start; }
  .show-media { position: relative; aspect-ratio: 1200 / 630; overflow: hidden; border-radius: 14px; background: var(--media-bg); }
  .show-media img { position: absolute; inset: 0; width: 108%; max-width: none; height: 100%; object-fit: cover; left: -4%; transition: transform .9s var(--ease-out-expo); }
  .show-card:hover .show-media img { transform: scale(1.05); }
  .show-num { display: inline-block; margin-top: 20px; color: var(--ct); font-size: 12px; font-weight: 700; letter-spacing: .2em; }
  .show-card h3 { margin-top: 6px; font-size: clamp(20px, 1.8vw, 30px); font-weight: 500; font-family: var(--font-body); }
  .show-card p { margin-top: 6px; color: var(--muted); font-size: 15px; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; max-width: 60ch; }
  .show-end { flex: 0 0 auto; display: flex; flex-direction: column; justify-content: center; gap: 22px; padding-right: var(--gutter); }
  .show-end .display { font-size: clamp(48px, 7vw, 120px); }
  @media (max-width: 900px) { .show-intro { grid-template-columns: 1fr; } .show-card { flex-basis: 82vw; } }

  /* ---- zoom phrases ---- */
  .zoom { position: relative; }
  .zoom-stage { padding: 12vh var(--gutter); display: grid; gap: 10vh; text-align: center; }
  .zoom-phrase { font-family: var(--font-display); text-transform: uppercase; line-height: .88; font-size: clamp(56px, 10vw, 180px); }
  .zoom-phrase .sm { display: block; font-size: .42em; color: var(--accent-text); letter-spacing: .02em; margin-bottom: .1em; }
  .zoom-fill { display: none; }
  .live .zoom-stage { position: relative; height: 100vh; padding: 0; overflow: hidden; }
  .live .zoom-phrase { position: absolute; inset: 0; display: flex; flex-direction: column; justify-content: center; align-items: center; opacity: 0; will-change: transform, opacity; }
  .live .zoom-fill { display: block; position: absolute; inset: 0; background: var(--alt-bg); opacity: 0; }

  /* ---- light half ---- */
  .light { background: var(--alt-bg); color: var(--alt-fg); position: relative; z-index: 1; transition: background-color .4s ease, color .4s ease; }
  .stack-wrap { padding: 14vh var(--gutter) 30vh; position: relative; }
  .stack-head { position: sticky; top: 14vh; z-index: 0; text-align: right; margin-left: auto; width: fit-content; }
  .stack-head .wide { font-size: clamp(34px, 5vw, 90px); }
  .stack-head .wide + .wide { color: var(--alt-muted); }
  .stack { margin-top: -12vh; position: relative; z-index: 1; }
  .stack-card {
    position: sticky; top: calc(12vh + var(--i) * 18px);
    margin-left: calc(var(--i) * min(4.4vw, 64px));
    width: min(520px, 40vw); margin-bottom: 26vh;
    display: flex; flex-direction: column; gap: 18px; padding: clamp(18px, 2vw, 32px);
    border: 1px solid var(--alt-border); border-radius: 4px;
    background: color-mix(in oklab, var(--alt-bg) 82%, transparent);
    backdrop-filter: blur(14px); -webkit-backdrop-filter: blur(14px);
    transform-origin: 50% 0;
  }
  .stack-card:last-child { margin-bottom: 0; }
  .stack-new { align-self: flex-end; padding: 4px 10px; border-radius: 999px; background: var(--accent); color: var(--accent-ink); font-size: 12px; font-weight: 700; letter-spacing: .1em; }
  .stack-thumb { aspect-ratio: 16 / 9; overflow: hidden; border-radius: 2px; background: var(--thumb-bg); }
  .stack-thumb img { width: 100%; height: 100%; object-fit: cover; filter: grayscale(1) contrast(1.05); transition: filter .6s ease, transform .9s var(--ease-out-expo); }
  .stack-card:hover .stack-thumb img { filter: none; transform: scale(1.04); }
  .stack-card h3 { font-size: clamp(16px, 1.35vw, 22px); }
  @media (max-width: 900px) {
    .stack-head { position: relative; top: 0; text-align: left; margin: 0 0 6vh; }
    .stack { margin-top: 0; }
    .stack-card { width: 100%; margin-left: 0; top: calc(80px + var(--i) * 12px); margin-bottom: 12vh; }
  }

  .res { padding: 4vh var(--gutter) 16vh; }
  .res-head { display: flex; justify-content: space-between; align-items: end; gap: 24px; padding-bottom: 28px; border-bottom: 2px solid var(--fg); }
  .res-count { font-size: 14px; color: var(--muted); }
  .res-row {
    position: relative; display: grid; grid-template-columns: 80px 1.1fr 1.4fr 40px; gap: 24px; align-items: center;
    padding: 30px 0; border-bottom: 1px solid color-mix(in oklab, var(--fg) 18%, transparent); isolation: isolate;
  }
  .res-row::before {
    content: ""; position: absolute; inset: 0 calc(-1 * var(--gutter)); z-index: -1;
    background: var(--c); transform: scaleY(0); transform-origin: 50% 100%;
    transition: transform .6s var(--ease-out-expo);
  }
  .res-row:hover::before { transform: scaleY(1); transform-origin: 50% 0; }
  .res-num { font-family: var(--font-display); font-size: 34px; color: var(--muted); transition: color .3s; }
  .res-row { transition: color .3s; }
  .res-row:hover { color: var(--c-ink); }
  .res-row:hover .res-num, .res-row:hover p { color: var(--c-ink); }
  .res-row h3 { font-size: clamp(18px, 2vw, 32px); }
  .res-row p { color: var(--body); font-size: 15px; transition: color .3s; }
  .res-row svg { width: 28px; height: 28px; transition: transform .5s var(--ease-out-expo); }
  .res-row:hover svg { transform: rotate(45deg); }
  @media (max-width: 800px) {
    .res-row { grid-template-columns: 48px 1fr 28px; }
    .res-row p { grid-column: 2 / 3; }
    .res-row svg { grid-row: 1; grid-column: 3; }
  }

  /* ---- footer ---- */
  footer { background: var(--bg); color: var(--fg); transition: background-color .4s ease, color .4s ease; border-radius: 28px 28px 0 0; margin-top: -28px; padding: 12vh 0 32px; overflow: hidden; }
  .marquee { display: flex; white-space: nowrap; font-family: var(--font-display); text-transform: uppercase; font-size: clamp(80px, 16vw, 260px); line-height: .9; }
  .marquee-inner { display: flex; flex-shrink: 0; padding-right: .3em; gap: .3em; will-change: transform; }
  .marquee .o { color: transparent; -webkit-text-stroke: 2px var(--accent3); }
  .marquee .o.g { -webkit-text-stroke-color: var(--accent2); }
  .marquee a:hover { color: var(--accent-text); }
  .foot-grid { padding: 10vh var(--gutter) 0; display: grid; grid-template-columns: 1.4fr 1fr; gap: 40px; }
  .foot-grid h4 { margin: 0 0 16px; font-size: 12px; letter-spacing: .2em; text-transform: uppercase; color: var(--muted); }
  .foot-links { display: flex; flex-direction: column; gap: 8px; font-weight: 700; text-transform: uppercase; font-size: 15px; }
  .foot-links a { display: inline-flex; gap: 10px; align-items: center; width: fit-content; }
  .foot-links a:hover { color: var(--accent-text); }
  .foot-links svg { width: 18px; height: 18px; }
  .foot-bio { font-size: clamp(18px, 1.6vw, 24px); max-width: 30ch; }
  .foot-base { display: flex; justify-content: space-between; gap: 20px; flex-wrap: wrap; padding: 8vh var(--gutter) 0; color: var(--muted); font-size: 13px; text-transform: uppercase; letter-spacing: .08em; }
  .foot-base a:hover { color: var(--accent-text); }
  @media (max-width: 800px) { .foot-grid { grid-template-columns: 1fr; } }
</style>
</head>
<body>
<div id="progress" aria-hidden="true"></div>
<canvas id="stars" aria-hidden="true"></canvas>
<div class="glow" aria-hidden="true"></div>
<div id="cursor" aria-hidden="true"></div>

<header class="nav" id="nav">
  <nav class="nav-group left" aria-label="Sections">
    <a href="#building">Building</a>
    <a href="#bake-offs">Bake-offs</a>
    <a href="#videos">Videos</a>
  </nav>
  <a class="badge" id="badge" href="#top" aria-label="Back to top">Rich Kuo</a>
  <nav class="nav-group right" aria-label="More">
    <a href="#resources">Resources</a>
    <a href={WORK_MAIL}>Work with me</a>
    <div class="theme-switch" role="group" aria-label="Color theme">
      <button type="button" data-theme-choice="system" aria-pressed="false" aria-label="System theme" title="System">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="12" rx="2" /><path d="M8 20h8M12 16v4" /></svg>
      </button>
      <button type="button" data-theme-choice="light" aria-pressed="false" aria-label="Light theme" title="Light">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" /></svg>
      </button>
      <button type="button" data-theme-choice="dark" aria-pressed="false" aria-label="Dark theme" title="Dark">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z" /></svg>
      </button>
    </div>
  </nav>
</header>

<main id="top">
  <section class="hero" aria-label="Intro">
    <h1 class="hero-name" id="heroName" aria-label="Rich Kuo">
      {['Rich', 'Kuo'].map((w) => (
        <span class="word" aria-hidden="true">{w.split('').map((c) => <span class="cl"><span class="ch">{c}</span></span>)}</span>
      ))}
    </h1>
    <p class="hero-role" id="heroRole" aria-label="Product Engineer">
      {'Product Engineer'.split('').map((c) => <span class="ch" aria-hidden="true">{c === ' ' ? ' ' : c}</span>)}
    </p>
    <nav class="hero-socials" id="heroSocials" aria-label="Social links">
      {socials.map((s) => {
        const ext = s.href.startsWith('http');
        return (
          <a href={s.href} aria-label={s.label} title={s.label} target={ext ? '_blank' : undefined} rel={ext ? 'noopener noreferrer' : undefined}>
            <Fragment set:html={ICONS[s.icon]} />
          </a>
        );
      })}
    </nav>
    <div class="hero-foot">
      <div class="scroll-cue" aria-hidden="true">Scroll to explore</div>
      <div class="hero-me">
        <Image class="avatar" src={profilePic} width={184} height={184} alt="Rich Kuo" loading="eager" />
        <p class="hero-tag">AI-native products end to end. <em>AI video tooling, trading bots, agent infrastructure</em>, and head-to-head LLM coding evaluations.</p>
      </div>
      <div class="pills">
        <a class="pill" href={WORK_MAIL}>
          <span class="ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M7 17L17 7M8 7h9v9" /></svg></span><span>Work with me</span>
        </a>
      </div>
    </div>
  </section>

  <section class="building" id="building" aria-labelledby="buildingTitle">
    <div class="building-head">
      <h2 class="display" id="buildingTitle">What<br />I'm<br />building</h2>
    </div>
    <div class="building-wrap">
    <div class="building-list" id="buildList">
      {building.map((p, i) => (
        <article class="build-item" style={tone(i)}>
          <span class="tag">{p.tag}</span>
          <h3 class="wide">{p.title}</h3>
          {p.badge && <span class="promo">{p.badge}</span>}
          {p.desc && <p>{p.desc}</p>}
          {p.link && (
            <a class="link-arrow" href={p.link} target="_blank" rel="noopener noreferrer">
              {prettyUrl(p.link)}
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><path d="M7 17L17 7M8 7h9v9" /></svg>
            </a>
          )}
        </article>
      ))}
    </div>
    </div>
  </section>

  <section class="res" id="resources" aria-labelledby="resTitle">
    <div class="res-head">
      <h2 class="display" id="resTitle">Resources</h2>
      <span class="wide res-count">{pad(resources.length)} guides &amp; tools</span>
    </div>
    {resources.map((r, i) => {
      const href = r.href ?? r.link ?? '#';
      const ext = isExternal(href);
      return (
        <a class="res-row" style={tone(i)} href={href} target={ext ? '_blank' : undefined} rel={ext ? 'noopener noreferrer' : undefined}>
          <span class="res-num">{pad(i + 1)}</span>
          <h3 class="wide">{r.title}</h3>
          {r.desc && <p>{r.desc}</p>}
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M7 17L17 7M8 7h9v9" /></svg>
        </a>
      );
    })}
  </section>

  <section class="show" id="bake-offs" aria-labelledby="showTitle">
    <div class="show-intro">
      <h2 class="display" id="showTitle">LLM<br />bake-offs</h2>
      <p>Head-to-head bake-offs scoring frontier AI models on identical real-world coding tasks: cost, speed, review rounds, and code quality.</p>
    </div>
    <div class="show-pin" id="showPin">
      <div class="show-track" id="showTrack">
        {llmBakeOffs.map((b, i) => (
          <a class="show-card" href={b.href} style={tone(i)}>
            <div class="show-media">
              {b.img && <img src={b.img} alt="" loading="lazy" />}
            </div>
            <span class="show-num">EP {pad(i + 1)}</span>
            <h3>{b.title}</h3>
            {b.desc && <p>{b.desc}</p>}
          </a>
        ))}
        <div class="show-end">
          <p class="display">More<br />soon</p>
          <a class="link-arrow" href="#videos">Watch the videos
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><path d="M7 17L17 7M8 7h9v9" /></svg>
          </a>
        </div>
      </div>
    </div>
  </section>

  <section class="zoom" id="zoom" aria-label="Interlude">
    <div class="zoom-stage" id="zoomStage">
      {zoomPhrases.map(([a, b]) => (
        <p class="zoom-phrase"><span class="sm">{a}</span>{b}</p>
      ))}
      <div class="zoom-fill" id="zoomFill" aria-hidden="true"></div>
    </div>
  </section>

  <div class="light" id="light">
    <section class="stack-wrap" id="videos" aria-labelledby="videosTitle">
      <div class="stack-head">
        <h2 id="videosTitle"><span class="wide" style="display:block">Videos</span><span class="wide" style="display:block">&amp; tutorials</span></h2>
      </div>
      <div class="stack">
        {videos.map((v, i) => (
          <a class="stack-card" style={`--i:${i}; ${tone(i)}`} href={v.link} target="_blank" rel="noopener noreferrer">
            {newLinks.has(v.link) && <span class="stack-new">NEW</span>}
            {v.vid && (
              <div class="stack-thumb"><img src={`https://img.youtube.com/vi/${v.vid}/mqdefault.jpg`} alt="" loading="lazy" /></div>
            )}
            <h3 class="wide">{v.title}</h3>
          </a>
        ))}
      </div>
    </section>
  </div>
</main>

<footer>
  <div class="marquee" id="marquee">
    {[0, 1].map((k) => (
      <div class="marquee-inner" aria-hidden={k === 1 ? 'true' : undefined}>
        <a href={WORK_MAIL} tabindex={k === 1 ? '-1' : undefined}>Work with me</a><span class="o">Let's build</span>
        <a href={WORK_MAIL} tabindex="-1">Work with me</a><span class="o g">Let's build</span>
      </div>
    ))}
  </div>
  <div class="foot-grid">
    <p class="foot-bio">Product engineer who ships AI-native products end to end.</p>
    <div>
      <h4>Elsewhere</h4>
      <div class="foot-links">
        {socials.map((s) => (
          <a href={s.href} target={s.href.startsWith('http') ? '_blank' : undefined} rel={s.href.startsWith('http') ? 'noopener noreferrer' : undefined}>
            <Fragment set:html={ICONS[s.icon]} />{s.label}
          </a>
        ))}
      </div>
    </div>
  </div>
  <div class="foot-base">
    <span>&copy; 2026 Rich Kuo</span>
    <a href="/classic/">Classic site</a>
  </div>
</footer>

<script is:inline src="https://cdn.jsdelivr.net/npm/gsap@3.13.0/dist/gsap.min.js" integrity="sha384-HOvlOYPIs/zjoIkWUGXkVmXsjr8GuZLV+Q+rcPwmJOVZVpvTSXQChiN4t9Euv9Vc" crossorigin="anonymous"></script>
<script is:inline src="https://cdn.jsdelivr.net/npm/gsap@3.13.0/dist/ScrollTrigger.min.js" integrity="sha384-P8VzCVnT9NBUkMrpcIZrJbA7EBjJvh/fJS6PmP+4nLIM284DtsImIv8D0fFjIkeh" crossorigin="anonymous"></script>
<script is:inline src="https://cdn.jsdelivr.net/npm/lenis@1.3.26/dist/lenis.min.js" integrity="sha384-jqpi9VmOdhyLoLURgjCn7EpnG9BbnHW57ibIZoeaIU+erWDH3k8fQQg0xH2ySjnw" crossorigin="anonymous"></script><script is:inline>
(function () {
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const nav = document.getElementById('nav');

  const canvas = document.getElementById('stars');
  const ctx = canvas.getContext('2d');
  const STAR_TINTS = {
    dark: ['251, 191, 36', '251, 191, 36', '251, 191, 36', '22, 163, 74', '65, 105, 225', '220, 38, 38'],
    light: ['22, 163, 74', '22, 163, 74', '22, 163, 74', '251, 191, 36', '65, 105, 225', '220, 38, 38'],
  };
  const root = document.documentElement;
  const NEAR = 0.04;
  let stars = [];
  let cx = 0;
  let cy = 0;
  let fov = 0;
  let boost = 0;
  let lastT = 0;
  function spawn(s, far) {
    s.x = (Math.random() * 2 - 1) * 1.3;
    s.y = (Math.random() * 2 - 1) * 1.3;
    s.z = far ? 0.8 + Math.random() * 0.2 : NEAR + Math.random() * (1 - NEAR);
    s.r = Math.random() * 1.1 + 0.4;
    s.k = Math.floor(Math.random() * STAR_TINTS.dark.length);
    return s;
  }
  function spawnEdge(s) {
    spawn(s, false);
    s.z = 0.2 + Math.random() * 0.4;
    const w = innerWidth + 40;
    const h = innerHeight + 40;
    const p = Math.random() * 2 * (w + h);
    const px = p < w ? p : p < w + h ? w : p < 2 * w + h ? 2 * w + h - p : 0;
    const py = p < w ? 0 : p < w + h ? p - w : p < 2 * w + h ? h : 2 * (w + h) - p;
    s.x = ((px - 20 - cx) * s.z) / fov;
    s.y = ((py - 20 - cy) * s.z) / fov;
  }
  function sizeStars() {
    const dpr = Math.min(devicePixelRatio || 1, 2);
    canvas.width = innerWidth * dpr;
    canvas.height = innerHeight * dpr;
    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    cx = innerWidth / 2;
    cy = innerHeight / 2;
    fov = Math.max(cx, cy) * 0.6;
    const n = Math.round((innerWidth * innerHeight) / 7000);
    stars = Array.from({ length: n }, () => spawn({}, false));
  }
  function drawStars(t) {
    const dt = lastT ? Math.max(0, Math.min((t - lastT) / 1000, 0.05)) : 0;
    lastT = t;
    const speed = boost * 0.012;
    const dir = speed < 0 ? -1 : 1;
    const trail = 0.004 + Math.abs(speed) * 0.35;
    const tints = root.getAttribute('data-theme') === 'light' ? STAR_TINTS.light : STAR_TINTS.dark;
    ctx.clearRect(0, 0, innerWidth, innerHeight);
    ctx.lineCap = 'round';
    for (const s of stars) {
      s.z -= speed * dt;
      if (s.z <= NEAR) { spawn(s, true); continue; }
      if (s.z > 1) { spawnEdge(s); continue; }
      const k = fov / s.z;
      const hx = cx + s.x * k;
      const hy = cy + s.y * k;
      if (speed >= 0 && (hx < -40 || hx > innerWidth + 40 || hy < -40 || hy > innerHeight + 40)) { spawn(s, true); continue; }
      const tk = fov / Math.max(NEAR / 2, s.z + trail * dir);
      const tx = cx + s.x * tk;
      const ty = cy + s.y * tk;
      const depth = 1 - s.z;
      const tint = tints[s.k];
      const g = ctx.createLinearGradient(tx, ty, hx, hy);
      g.addColorStop(0, 'rgba(' + tint + ',0)');
      g.addColorStop(1, 'rgba(' + tint + ',' + Math.min(1, depth * 1.4).toFixed(3) + ')');
      ctx.strokeStyle = g;
      ctx.lineWidth = s.r * (0.4 + depth * 2);
      ctx.beginPath();
      ctx.moveTo(tx, ty);
      ctx.lineTo(hx, hy);
      ctx.stroke();
    }
  }
  sizeStars();
  addEventListener('resize', () => { sizeStars(); drawStars(0); });
  drawStars(0);

  const darkMq = matchMedia('(prefers-color-scheme: dark)');
  const themeMeta = document.getElementById('themeColor');
  const themeButtons = document.querySelectorAll('[data-theme-choice]');
  function readPref() {
    try {
      const v = localStorage.getItem('theme-pref');
      return v === 'dark' || v === 'light' ? v : 'system';
    } catch (e) {
      return 'system';
    }
  }
  function applyTheme(pref) {
    const dark = pref === 'system' ? darkMq.matches : pref === 'dark';
    root.setAttribute('data-theme', dark ? 'dark' : 'light');
    root.setAttribute('data-theme-pref', pref);
    themeMeta.setAttribute('content', dark ? '#050505' : '#efefef');
    themeButtons.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.themeChoice === pref)));
    drawStars(performance.now());
  }
  themeButtons.forEach((b) => b.addEventListener('click', () => {
    const pref = b.dataset.themeChoice;
    try {
      if (pref === 'system') localStorage.removeItem('theme-pref');
      else localStorage.setItem('theme-pref', pref);
    } catch (e) {}
    applyTheme(pref);
  }));
  darkMq.addEventListener('change', () => { if (readPref() === 'system') applyTheme('system'); });
  applyTheme(readPref());

  if (typeof gsap === 'undefined' || typeof ScrollTrigger === 'undefined') return;
  gsap.registerPlugin(ScrollTrigger);

  ScrollTrigger.create({
    trigger: '#light', start: 'top 40px', end: 'bottom 40px',
    refreshPriority: -1,
    onToggle: (self) => nav.classList.toggle('on-alt', self.isActive),
  });
  gsap.to('#progress', { scaleX: 1, ease: 'none', scrollTrigger: { start: 0, end: 'max', scrub: true } });

  if (reduce) return;

  document.documentElement.classList.add('live');

  const lenis = new Lenis({ lerp: 0.1, anchors: { offset: 0 } });
  lenis.on('scroll', ScrollTrigger.update);
  gsap.ticker.add((time) => {
    lenis.raf(time * 1000);
    boost += (Math.max(-80, Math.min(lenis.velocity, 80)) - boost) * 0.15;
    drawStars(time * 1000);
  });
  gsap.ticker.lagSmoothing(0);
  document.getElementById('badge').addEventListener('click', (e) => { e.preventDefault(); lenis.scrollTo(0); });

  const intro = gsap.timeline({ defaults: { ease: 'expo.out' } });
  intro
    .from('#heroName .ch', { yPercent: 110, duration: 1.4, stagger: 0.05 })
    .from('#heroRole .ch', { opacity: 0, y: 30, duration: 0.9, stagger: 0.025 }, '-=1.0')
    .from('#heroSocials a', { opacity: 0, y: 20, duration: 0.8, stagger: 0.04 }, '-=0.7')
    .from('.hero-foot > *', { opacity: 0, y: 30, duration: 1, stagger: 0.1 }, '-=0.8');

  gsap.utils.toArray('#heroName .cl').forEach((ch, i, all) => {
    const mid = (all.length - 1) / 2;
    gsap.to(ch, {
      yPercent: -4 - Math.abs(i - mid) * 4,
      ease: 'none',
      scrollTrigger: { trigger: '.hero', start: 'top top', end: 'bottom top', scrub: true },
    });
  });
  gsap.to('#heroSocials', { opacity: 0, ease: 'none', scrollTrigger: { trigger: '.hero', start: 'center top', end: 'bottom top', scrub: true } });
  gsap.to('#heroRole', { xPercent: 8, opacity: 0, ease: 'none', scrollTrigger: { trigger: '.hero', start: 'center top', end: 'bottom top', scrub: true } });

  const heroName = document.getElementById('heroName');
  const badge = document.getElementById('badge');
  const pageTop = (el) => { let y = 0; for (let n = el; n; n = n.offsetParent) y += n.offsetTop; return y; };
  const mergeEnd = () => Math.max(200, pageTop(heroName) + heroName.offsetHeight - (badge.offsetTop + badge.offsetHeight / 2));
  const nameWidth = () => {
    const ws = [...heroName.querySelectorAll('.word')];
    return Math.max(...ws.map((w) => w.offsetLeft + w.offsetWidth)) - Math.min(...ws.map((w) => w.offsetLeft));
  };
  const badgeTextWidth = () => { const r = document.createRange(); r.selectNodeContents(badge); return r.getBoundingClientRect().width; };
  gsap.timeline({
    scrollTrigger: { trigger: '.hero', start: 'top top', end: () => '+=' + mergeEnd(), scrub: true, invalidateOnRefresh: true },
  })
    .to(heroName, {
      x: () => badge.offsetLeft + badge.offsetWidth / 2 - (heroName.offsetLeft + heroName.offsetWidth / 2),
      y: () => badge.offsetTop + badge.offsetHeight / 2 + mergeEnd() - (pageTop(heroName) + heroName.offsetHeight / 2),
      ease: 'none',
      duration: 1,
    }, 0)
    .to(heroName, { scale: () => badgeTextWidth() / nameWidth(), ease: 'power3.out', duration: 1 }, 0)
    .to(heroName, { opacity: 0, ease: 'none', duration: 0.3 }, 0.7)
    .fromTo(badge, { autoAlpha: 0, filter: 'blur(8px)' }, { autoAlpha: 1, filter: 'blur(0px)', ease: 'none', duration: 0.3 }, 0.7);

  const builds = gsap.utils.toArray('.build-item');
  const list = document.getElementById('buildList');
  const wrap = list.parentElement;
  const vdist = () => Math.max(0, list.offsetHeight - wrap.clientHeight);
  const focusItems = () => {
    const wr = wrap.getBoundingClientRect();
    const mid = wr.top + wr.height / 2;
    builds.forEach((el) => {
      const r = el.getBoundingClientRect();
      const d = Math.min(1, Math.abs(r.top + r.height / 2 - mid) / (wr.height * 0.55));
      el.style.opacity = String(1 - d * 0.75);
    });
  };
  gsap.to(list, {
    y: () => -vdist(), ease: 'none', onUpdate: focusItems,
    scrollTrigger: { trigger: '#building', start: 'top top', end: () => '+=' + vdist(), pin: true, scrub: 1, invalidateOnRefresh: true, anticipatePin: 1, onRefresh: focusItems },
  });
  focusItems();
  gsap.from('.build-item > *', {
    y: 60, opacity: 0, stagger: 0.05, duration: 1.2, ease: 'expo.out',
    scrollTrigger: { trigger: '#building', start: 'top 70%' },
  });

  const track = document.getElementById('showTrack');
  const dist = () => Math.max(0, track.scrollWidth - innerWidth);
  const slide = gsap.to(track, {
    x: () => -dist(), ease: 'none',
    scrollTrigger: { trigger: '#showPin', start: 'top top', end: () => '+=' + dist(), pin: true, scrub: 1, invalidateOnRefresh: true, anticipatePin: 1 },
  });
  gsap.utils.toArray('.show-media img').forEach((img) => {
    gsap.fromTo(img, { xPercent: -3.5 }, {
      xPercent: 3.5, ease: 'none',
      scrollTrigger: { trigger: img.parentElement, containerAnimation: slide, start: 'left right', end: 'right left', scrub: true },
    });
  });
  gsap.from('.show-card', {
    y: 80, opacity: 0, stagger: 0.08, duration: 1.2, ease: 'expo.out',
    scrollTrigger: { trigger: '#showPin', start: 'top 70%' },
  });

  const phrases = gsap.utils.toArray('.zoom-phrase');
  const zoom = gsap.timeline({
    defaults: { ease: 'none' },
    scrollTrigger: { trigger: '#zoomStage', start: 'top top', end: '+=' + phrases.length * 120 + '%', pin: true, scrub: 1 },
  });
  phrases.forEach((p, i) => {
    const last = i === phrases.length - 1;
    zoom.fromTo(p, { opacity: 0, scale: 0.6 }, { opacity: 1, scale: 1, duration: 1 });
    if (last) {
      zoom.to(p, { scale: 26, duration: 2, ease: 'power2.in' });
      zoom.to('#zoomFill', { opacity: 1, duration: 0.6 }, '-=0.7');
    } else {
      zoom.to(p, { scale: 5, opacity: 0, duration: 1.4, ease: 'power2.in' }, '+=0.4');
    }
  });

  const cards = gsap.utils.toArray('.stack-card');
  cards.forEach((card, i) => {
    gsap.from(card, { y: 120, rotate: 2, opacity: 0, ease: 'expo.out', duration: 1.2, scrollTrigger: { trigger: card, start: 'top 95%' } });
    const next = cards[i + 1];
    if (!next) return;
    gsap.to(card, {
      scale: 0.94, filter: 'blur(2px)', ease: 'none',
      scrollTrigger: { trigger: next, start: 'top 90%', end: 'top 30%', scrub: true },
    });
  });

  gsap.from('.res-row', { y: 40, opacity: 0, stagger: 0.08, duration: 1, ease: 'expo.out', scrollTrigger: { trigger: '.res', start: 'top 75%' } });

  const inners = gsap.utils.toArray('.marquee-inner');
  let mx = 0;
  let speed = 1;
  lenis.on('scroll', (e) => { speed = 1 + Math.min(Math.abs(e.velocity) * 0.15, 8); });
  gsap.ticker.add(() => {
    const w = inners[0].offsetWidth;
    if (!w) return;
    mx = (mx - speed) % w;
    speed += (1 - speed) * 0.05;
    inners.forEach((el) => { el.style.transform = 'translate3d(' + mx + 'px,0,0)'; });
  });

  if (matchMedia('(pointer: fine)').matches) {
    const cur = document.getElementById('cursor');
    const xTo = gsap.quickTo(cur, 'x', { duration: 0.45, ease: 'power3' });
    const yTo = gsap.quickTo(cur, 'y', { duration: 0.45, ease: 'power3' });
    addEventListener('pointermove', (e) => { cur.style.opacity = 1; xTo(e.clientX); yTo(e.clientY); });
    document.addEventListener('pointerleave', () => { cur.style.opacity = 0; });
    document.querySelectorAll('a, button').forEach((el) => {
      el.addEventListener('pointerenter', () => cur.classList.add('is-hover'));
      el.addEventListener('pointerleave', () => cur.classList.remove('is-hover'));
    });
  }

  function fitName() {
    const h = document.getElementById('heroName');
    h.style.fontSize = '';
    if (innerWidth <= 700) return;
    const avail = h.clientWidth;
    h.style.fontSize = '100px';
    const words = h.querySelectorAll('.word');
    let w = 0;
    words.forEach((el) => { w += el.scrollWidth; });
    w += 12 * (words.length - 1);
    h.style.fontSize = Math.floor((77 * avail) / w) + 'px';
  }
  function fitRole() {
    const r = document.getElementById('heroRole');
    r.style.fontSize = '100px';
    const chs = r.querySelectorAll('.ch');
    const w = chs[chs.length - 1].getBoundingClientRect().right - chs[0].getBoundingClientRect().left;
    if (w) r.style.fontSize = ((100 * r.clientWidth) / w).toFixed(2) + 'px';
  }
  function fitHero() { fitName(); fitRole(); }
  fitHero();
  if (document.fonts) document.fonts.ready.then(() => { fitHero(); ScrollTrigger.refresh(); });
  addEventListener('resize', fitHero);
})();
</script>
</body>
</html>
